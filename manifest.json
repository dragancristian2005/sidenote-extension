{
  "manifest_version": 3,
  "name": "Sidenote",
  "version": "0.1.1",
  "description": "Chat with your own AI model about the current tab: selection, page, other tabs, screenshot or PDF. Bring your own API key.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sidenote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "focus-input": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Focus the Sidenote message box"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
