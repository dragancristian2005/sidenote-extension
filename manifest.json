{
  "manifest_version": 3,
  "name": "Sidenote",
  "version": "0.1.0",
  "description": "Chat with your own AI model (Gemini, Claude, OpenAI…) about the current tab: selection, page, other tabs, screenshot or PDF.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sidenote"
  },
  "commands": {
    "focus-input": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Focus the Sidenote message box"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
